<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net462</TargetFrameworks>
    <Version>4.0.0</Version>
    <Description>
C#/.NET library that adds Docker container sessions to Atata using Testcontainers library.

Atata.Testcontainers on GitHub: https://github.com/atata-framework/atata-testcontainers
Atata Framework documentation: https://atata.io/

The package targets .NET 8.0 and .NET Framework 4.6.2.
    </Description>
    <RepositoryUrl>https://github.com/atata-framework/atata-testcontainers</RepositoryUrl>
    <PackageId>Atata.Testcontainers</PackageId>
    <PackageTags>atata automation testing test testcontainers</PackageTags>
    <PackageReleaseNotes>Changelog: https://github.com/atata-framework/atata-testcontainers/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/atata-framework/atata-testcontainers</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Atata" Version="4.0.0" />
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" />
    <PackageReference Include="Testcontainers" Version="4.15.0" />
  </ItemGroup>

</Project>
